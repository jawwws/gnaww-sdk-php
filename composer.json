{
    "name": "jawwws/gnaww-sdk",
    "description": "Official PHP SDK for the Gnaww print intelligence API.",
    "keywords": [
        "gnaww",
        "print",
        "sdk",
        "api"
    ],
    "homepage": "https://gnaww.io",
    "license": "MIT",
    "authors": [
        {
            "name": "Jawwws Ltd"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "Jawwws\\Gnaww\\": "lib/"
        }
    },
    "support": {
        "source": "https://github.com/jawwws/gnaww-sdk-php"
    }
}
